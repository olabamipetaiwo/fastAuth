# Postgres (used by docker-compose.yml and by the app's DATABASE_URL below —
# keep the credentials in sync between the two)
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth
POSTGRES_DB=auth

# asyncpg connection string. Host is "localhost" when running the app
# outside docker and pointing at the docker-compose postgres container.
DATABASE_URL=postgresql://auth:auth@localhost:5432/auth

# JWT signing. Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256

# Token lifetimes, in seconds
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Cookie flags. Set COOKIE_SECURE=false for local HTTP dev only — a browser
# silently drops Secure cookies over plain HTTP, which looks like "login
# just doesn't work" if you forget this exists.
COOKIE_SECURE=true
COOKIE_DOMAIN=localhost
